# --- Project-specific: large/raw data and model artifacts ---
# Raw source dataset is large and reproducibly downloadable; not committed.
data/raw/
# Trained model binaries are large (>100MB) and reproducible via `python -m src.models.train_augmented`.
# They are kept out of git history to avoid repository bloat and GitHub file size limits.
# Small JSON result/metric files and folder structure (.gitkeep) ARE committed.
models_saved/*.joblib
models_saved/*.pkl
models_saved/*.pickle
*.joblib
*.pkl
*.pickle
!models_saved/.gitkeep
!models_saved/*.json

# Prediction logs written by the API at runtime (not source-controlled).
logs/
*.log

# --- Secrets ---
.env
*.pem

# --- Terraform (Phase 10) ---
# State files can contain sensitive resource details (ARNs, IDs) and must
# never be committed, especially to a public repo. .terraform/ is a large,
# locally-downloaded provider plugin cache. .terraform.lock.hcl IS committed
# (Terraform's own recommendation, for reproducible provider version pins).
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
terraform/*.tfvars.json